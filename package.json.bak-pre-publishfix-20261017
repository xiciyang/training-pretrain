{
  "name": "training-pretrain",
  "version": "0.1.0",
  "description": "继续预训练（continued pretraining）薄插件：领域语料校验（双轨去泄漏 + 全量 PII）→ 公共训练循环（training-core，容器内 transformers）→ 分片续训（步号与数据位置连续性机器可验）→ 合并 → serving 部署 → 遗忘门禁。依赖长任务 1 冻结的六个 @ai-infra/* 共享库。",
  "private": true,
  "type": "module",
  "main": "./src/index.mjs",
  "bin": { "training-pretrain": "./bin/training-pretrain.mjs" },
  "exports": {
    ".": { "default": "./src/index.mjs" },
    "./tools": { "default": "./src/tools.mjs" },
    "./package.json": "./package.json"
  },
  "files": ["src", "bin", "mcp", "python", "skills", "manifest.yaml", "cordis.patch.yml"],
  "license": "BSD-3-Clause",
  "dependencies": {
    "@ai-infra/testing-core": "file:../shared/libs/testing-core",
    "@ai-infra/data-core": "file:../shared/libs/data-core",
    "@ai-infra/state-core": "file:../shared/libs/state-core",
    "@ai-infra/audit-core": "file:../shared/libs/audit-core",
    "@ai-infra/sandbox-core": "file:../shared/libs/sandbox-core",
    "@ai-infra/training-core": "file:../shared/libs/training-core"
  },
  "optionalDependencies": {
    "torch": ">=2.0.0 <3",
    "transformers": ">=4.40.0 <6",
    "accelerate": ">=0.30.0 <2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5"
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "test:unit": "node tests/run.mjs",
    "test:contract": "node ../inference-contracts/checks/run-all.mjs",
    "audit-corpus": "node step0/step0-corpus-audit.mjs",
    "health": "node bin/training-pretrain.mjs health"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
